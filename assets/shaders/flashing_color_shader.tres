[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 0.000000, 0.000000, 1.000000);
uniform float speed = 5.0;



void fragment() {
// Input:3
	vec4 n_out3p0 = COLOR;


// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// FloatParameter:7
	float n_out7p0 = speed;


// Input:2
	float n_out2p0 = TIME;


// FloatOp:8
	float n_out8p0 = n_out7p0 * n_out2p0;


// FloatFunc:5
	float n_out5p0 = sin(n_out8p0);


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out4p0.xyz) * vec3(n_out5p0);


// Mix:10
	vec3 n_out10p0 = mix(vec3(n_out3p0.xyz), n_out6p0, vec3(n_out5p0));


// Output:0
	COLOR.rgb = n_out10p0;


}
"
