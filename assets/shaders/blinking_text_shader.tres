[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 blink_color : source_color = vec4(1.000000, 0.784314, 0.341176, 1.000000);
uniform float blink_speed = 5.0;



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// ColorParameter:3
	vec4 n_out3p0 = blink_color;


// Input:6
	float n_out6p0 = TIME;


// FloatParameter:8
	float n_out8p0 = blink_speed;


// FloatOp:7
	float n_out7p0 = n_out6p0 * n_out8p0;


// FloatFunc:4
	float n_out4p0 = sin(n_out7p0);


// Mix:5
	vec4 n_out5p0 = mix(n_out2p0, n_out3p0, vec4(n_out4p0));


// Output:0
	COLOR.rgb = vec3(n_out5p0.xyz);


}
"
