code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 replacement_color : source_color = vec4(0.349020, 0.000000, 1.000000, 1.000000);



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p3 = n_out2p0.b;


// VectorOp:5
	vec3 n_in5p1 = vec3(1.00000, 1.00000, 0.00000);
	vec3 n_out5p0 = vec3(n_out2p0.xyz) * n_in5p1;


// VectorLen:4
	float n_out4p0 = length(n_out5p0);


// Step:7
	float n_in7p0 = 0.95000;
	float n_out7p0 = step(n_in7p0, n_out4p0);


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out7p0) * vec3(n_out2p0.xyz);


// FloatFunc:8
	float n_out8p0 = 1.0 - n_out7p0;


// FloatOp:10
	float n_out10p0 = n_out8p0 * n_out2p3;


// ColorParameter:13
	vec4 n_out13p0 = replacement_color;


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out10p0) * vec3(n_out13p0.xyz);


// VectorOp:12
	vec3 n_out12p0 = n_out11p0 + n_out6p0;


// Output:0
	COLOR.rgb = n_out12p0;


}
"
