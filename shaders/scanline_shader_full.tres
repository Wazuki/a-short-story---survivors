code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(0.000000, 1.000000, 1.000000, 0.300000);
uniform float speed = 0.5;



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;
	float n_out2p2 = n_out2p0.g;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(TEXTURE, n_out2p0);


// ColorParameter:18
	vec4 n_out18p0 = ColorParameter;


// FloatParameter:9
	float n_out9p0 = speed;


// Input:8
	float n_out8p0 = TIME;


// FloatOp:11
	float n_out11p0 = n_out9p0 * n_out8p0;


// FloatFunc:21
	float n_out21p0 = -(n_out2p2);


// FloatOp:10
	float n_out10p0 = n_out11p0 + n_out21p0;


// FloatConstant:12
	float n_out12p0 = 20.000000;


// FloatOp:13
	float n_out13p0 = n_out10p0 * n_out12p0;


// FloatConstant:15
	float n_out15p0 = 0.500000;


// FloatOp:14
	float n_out14p0 = n_out13p0 * n_out15p0;


// FloatOp:17
	float n_out17p0 = n_out14p0 + n_out15p0;


// FloatFunc:7
	float n_out7p0 = sin(n_out17p0);


// FloatOp:20
	float n_out20p0 = n_out7p0 * n_out15p0;


// Mix:3
	vec4 n_out3p0 = mix(n_out6p0, n_out18p0, vec4(n_out20p0));


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);


}
