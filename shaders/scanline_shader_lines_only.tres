[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(0.000000, 1.000000, 1.000000, 0.300000);
uniform float frequency = 10.0;
uniform float speed = 0.33000001311302;
uniform float thickness = 0.30000001192093;



void fragment() {
// ColorParameter:18
	vec4 n_out18p0 = ColorParameter;


// FloatParameter:23
	float n_out23p0 = frequency;


// FloatParameter:9
	float n_out9p0 = speed;


// Input:8
	float n_out8p0 = TIME;


// Input:2
	vec2 n_out2p0 = UV;
	float n_out2p2 = n_out2p0.g;


// FloatFunc:30
	float n_out30p0 = -(n_out2p2);


// MultiplyAdd:25
	float n_out25p0 = (n_out9p0 * n_out8p0) + n_out30p0;


// FloatFunc:22
	float n_out22p0 = fract(n_out25p0);


// FloatOp:26
	float n_out26p0 = n_out23p0 * n_out22p0;


// FloatParameter:24
	float n_out24p0 = thickness;


// Step:27
	float n_out27p0 = step(n_out26p0, n_out24p0);


// VectorOp:28
	vec4 n_out28p0 = n_out18p0 * vec4(n_out27p0);


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(TEXTURE, n_out2p0);


// VectorOp:29
	vec4 n_out29p0 = n_out28p0 + n_out6p0;


// Output:0
	COLOR.rgb = vec3(n_out29p0.xyz);


}
"
